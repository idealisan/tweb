{
  // Static SPA: `pnpm deploy` builds into ./dist and uploads it as Workers assets.
  // No Worker script is used (assets-only deployment).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tweb",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
