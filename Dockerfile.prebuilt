# CI-only Dockerfile: reuses the frontend dist built once in the
# build-and-upload job (no frontend compilation, no QEMU emulation).
# The multi-arch aspect comes entirely from the caddy base image.
FROM caddy:2-alpine

WORKDIR /srv

COPY Caddyfile /etc/caddy/Caddyfile
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
COPY dist/ /srv/dist/

EXPOSE 8080

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
